#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage:
#   script/report rubocop
#   script/report ruby-requirements [--sample N]
#   script/report platforms [--sample N]
#   script/report gem-ages [--sample N]
#   script/report c-extensions [--sample N]
#   script/report ruby-deprecations
#   script/report case-collisions                       (full corpus, cache only)
#   script/report dependencies [--sample N]
#   script/report feature-usage [--sample N]
#   script/report portland-compatibility [--sample N]
#   script/report error-handling [--sample N]
#   script/report nil-idioms [--sample N]
#   script/report mutation-shapes [--sample N]
#   script/report heredocs [--sample N]
#   script/report all [--sample N]
#
# Every report runs against the full corpus unless --sample is given.
# Reports are written to reports/<timestamp>/<name>.{md,json} and mirrored
# to reports/latest/. All fetched data is cached under data/, so runs are
# resumable and repeat runs are free. The source-based reports (everything
# below ruby-deprecations) read .gem files from that cache; at full corpus
# each takes roughly 20 minutes of CPU and no network.

require_relative '../lib/ruby_research'

report_name = ARGV.shift
sample = nil
if (index = ARGV.index('--sample'))
  sample = Integer(ARGV[index + 1])
end

# --byte-budget 30GB (or 500MB / 123456789) aborts cleanly once that much
# has come over the wire; caches make rerunning resume where it stopped.
if (index = ARGV.index('--byte-budget'))
  value = ARGV[index + 1]
  multiplier = { 'kb' => 1024, 'mb' => 1024**2, 'gb' => 1024**3 }.fetch(value[/[a-z]+\z/i]&.downcase, 1)
  RubyResearch::HttpClient.byte_budget = (value.to_f * multiplier).to_i
end

reports = {
  'rubocop' => -> { RubyResearch::Reports::RubocopDiscouragements.new.run },
  'ruby-requirements' => -> { RubyResearch::Reports::RubyRequirements.new(sample: sample).run },
  'platforms' => -> { RubyResearch::Reports::Platforms.new(sample: sample).run },
  'gem-ages' => -> { RubyResearch::Reports::GemAges.new(sample: sample).run },
  'c-extensions' => -> { RubyResearch::Reports::CExtensions.new(sample: sample).run },
  'feature-usage' => -> { RubyResearch::Reports::FeatureUsage.new(sample: sample).run },
  'ruby-deprecations' => -> { RubyResearch::Reports::RubyDeprecations.new.run },
  'portland-compatibility' => -> { RubyResearch::Reports::PortlandCompatibility.new(sample: sample).run },
  'error-handling' => -> { RubyResearch::Reports::ErrorHandling.new(sample: sample).run },
  'nil-idioms' => -> { RubyResearch::Reports::NilIdioms.new(sample: sample).run },
  'mutation-shapes' => -> { RubyResearch::Reports::MutationShapes.new(sample: sample).run },
  'heredocs' => -> { RubyResearch::Reports::Heredocs.new(sample: sample).run },
  'case-collisions' => -> { RubyResearch::Reports::CaseCollisions.new.run },
  'dependencies' => -> { RubyResearch::Reports::Dependencies.new(sample: sample).run }
}

selected =
  case report_name
  when 'all' then reports.values
  when *reports.keys then [reports.fetch(report_name)]
  else
    warn "Unknown report: #{report_name.inspect}"
    warn "Available: #{reports.keys.join(', ')}, all"
    exit 1
  end

selected.each do |report|
  paths = report.call
  paths.each { puts "Wrote #{it}" }
end

megabytes = (RubyResearch::HttpClient.bytes_fetched / 1024.0 / 1024).round(1)
puts "Fetched #{megabytes} MB over the wire this run."
